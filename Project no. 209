
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class 12 Science Notes</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6fb;
            color: #222;
        }

        header {
            background: linear-gradient(135deg, #171b3c, #5555dc);
            color: white;
            padding: 35px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 35px;
            margin-bottom: 12px;
        }

        header p {
            font-size: 16px;
        }

        nav {
            background: #fff;
            padding: 16px;
            text-align: center;
            box-shadow: 0 2px 8px #ddd;
        }

        nav a {
            text-decoration: none;
            color: #4444c9;
            margin: 0 15px;
            font-weight: bold;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 30px 20px;
        }

        .search-box {
            width: 100%;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            margin-bottom: 30px;
            font-size: 16px;
        }

        .heading {
            text-align: center;
            margin-bottom: 25px;
            font-size: 28px;
        }

        .subjects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 22px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.07);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h2 {
            color: #4848cf;
            margin-bottom: 18px;
        }

        .card ul {
            list-style: none;
        }

        .card li {
            padding: 12px 0;
            border-bottom: 1px solid #eee;
        }

        .card a {
            text-decoration: none;
            color: #333;
        }

        .card a:hover {
            color: #5555dc;
        }

        footer {
            background: #171b3c;
            color: white;
            text-align: center;
            padding: 22px;
            margin-top: 40px;
        }

        @media(max-width: 600px) {
            header h1 {
                font-size: 27px;
            }

            nav a {
                margin: 0 7px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Class 12th Science Notes</h1>
        <p>Your Complete Study Material Platform</p>
    </header>

    <nav>
        <a href="#physics">Physics</a>
        <a href="#chemistry">Chemistry</a>
        <a href="#biology">Biology</a>
        <a href="#maths">Maths</a>
    </nav>

    <div class="container">

        <input
            type="text"
            id="search"
            class="search-box"
            placeholder="Search your subject or chapter..."
        >

        <h2 class="heading">Explore Subjects</h2>

        <div class="subjects">

            <!-- PHYSICS -->
            <div class="card" id="physics">
                <h2>⚡ Physics</h2>
                <ul>
                    <li><a href="#">01. Electric Charges and Fields</a></li>
                    <li><a href="#">02. Electrostatic Potential</a></li>
                    <li><a href="#">03. Current Electricity</a></li>
                    <li><a href="#">04. Moving Charges and Magnetism</a></li>
                    <li><a href="#">05. Magnetism and Matter</a></li>
                </ul>
            </div>

            <!-- CHEMISTRY -->
            <div class="card" id="chemistry">
                <h2>🧪 Chemistry</h2>
                <ul>
                    <li><a href="#">01. Solutions</a></li>
                    <li><a href="#">02. Electrochemistry</a></li>
                    <li><a href="#">03. Chemical Kinetics</a></li>
                    <li><a href="#">04. d and f Block Elements</a></li>
                    <li><a href="#">05. Coordination Compounds</a></li>
                </ul>
            </div>

            <!-- BIOLOGY -->
            <div class="card" id="biology">
                <h2>🌱 Biology</h2>
                <ul>
                    <li><a href="#">01. Sexual Reproduction in Flowering Plants</a></li>
                    <li><a href="#">02. Human Reproduction</a></li>
                    <li><a href="#">03. Reproductive Health</a></li>
                    <li><a href="#">04. Principles of Inheritance</a></li>
                    <li><a href="#">05. Molecular Basis of Inheritance</a></li>
                </ul>
            </div>

            <!-- MATHEMATICS -->
            <div class="card" id="maths">
                <h2>📐 Mathematics</h2>
                <ul>
                    <li><a href="#">01. Relations and Functions</a></li>
                    <li><a href="#">02. Inverse Trigonometric Functions</a></li>
                    <li><a href="#">03. Matrices</a></li>
                    <li><a href="#">04. Determinants</a></li>
                    <li><a href="#">05. Continuity and Differentiability</a></li>
                </ul>
            </div>

        </div>
    </div>

    <footer>
        <p>© 2026 Class 12 Science Notes | All Rights Reserved</p>
    </footer>

    <script>
        const search = document.getElementById("search");
        const cards = document.querySelectorAll(".card");

        search.addEventListener("input", function() {
            const value = search.value.toLowerCase();

            cards.forEach(card => {
                const content = card.textContent.toLowerCase();

                card.style.display =
                    content.includes(value) ? "block" : "none";
            });
        });
    </script>

</body>
</html>
